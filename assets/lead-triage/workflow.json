    {
      "parameters": {
        "jsCode": "const raw = $json.candidates?.[0]?.content?.parts?.[0]?.text;\n\nif (!raw) {\n  throw new Error('Classification call returned no content');\n}\n\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Classification response was not valid JSON: ' + cleaned.slice(0, 200));\n}\n\nconst validScores = ['Hot', 'Warm', 'Cold'];\nif (!validScores.includes(parsed.score)) {\n  throw new Error('Classification returned an invalid score: ' + parsed.score);\n}\n\nreturn {\n  score: parsed.score,\n  reasoning: parsed.reasoning || '',\n  keySignals: parsed.keySignals || [],\n  hedgingLanguagePresent: parsed.hedgingLanguagePresent || false\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        -192
      ],
      "id": "18b891d8-185c-4b8d-9ba0-a29059584a9f",

    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\n\nconst errors = [];\n\nif (!body.name || typeof body.name !== 'string' || body.name.trim().length === 0) {\n  errors.push('Missing or invalid \"name\" field');\n}\n\nif (!body.email || typeof body.email !== 'string') {\n  errors.push('Missing \"email\" field');\n} else {\n  const emailPattern = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  if (!emailPattern.test(body.email.trim())) {\n    errors.push('Invalid email format');\n  }\n}\n\nif (!body.message || typeof body.message !== 'string' || body.message.trim().length < 10) {\n  errors.push('Missing or too-short \"message\" field (minimum 10 characters)');\n}\n\nreturn {\n  isValid: errors.length === 0,\n  errors: errors,\n  name: (body.name || '').trim(),\n  email: (body.email || '').trim(),\n  message: (body.message || '').trim()\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -80
      ],
      "id": "de3190be-af99-44f0-95b5-1be86adfde4f",

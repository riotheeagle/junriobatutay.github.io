    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    \"contents\": [\n      {\n        \"role\": \"user\",\n        \"parts\": [\n          {\n            \"text\": \"You are writing a reply on behalf of a small business owner to an inbound lead. The lead has been scored: \" + $('Check classification succeeded + parse').first().json.score + \"\\nReasoning for that score: \" + $('Check classification succeeded + parse').first().json.reasoning + \"\\n\\nWrite a personalized reply email to \" + $('Validate input').first().json.name + \" responding to their message below. Match the tone and urgency to the score:\\n\\n- If Hot: respond with clear enthusiasm and urgency. Propose a specific next step (a call this week, a quick form to lock in a time) rather than general info. Keep it short \u2014 they're ready to move, don't slow them down with a wall of text.\\n- If Warm: be warm and helpful, answer their specific question if one was asked, and offer a low-pressure next step (a resource, an optional call) without pushing urgency they haven't shown.\\n- If Cold: be friendly and brief. Answer generally, invite them to reach out again when they have more specifics, and do not push for a call or commitment.\\n\\nRequirements:\\n- 80-150 words\\n- Sign off as \\\"The Team\\\" (no invented personal name)\\n- No corporate boilerplate (\\\"We appreciate your interest in our services\\\")\\n- Output ONLY the email body text, no subject line, no preamble\\n\\nOriginal lead message:\\n\" + $('Validate input').first().json.message\n          }\n        ]\n      }\n    ],\n    \"generationConfig\": {\n      \"maxOutputTokens\": 2000,\n      \"temperature\": 0.7\n    }\n  }\n}}",
        "options": {}
      },

                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "f551b5e4-a5be-4c9d-a05b-d36ea30be9fd",
      "name": "Check Blog Post succeeded",
      "type": "n8n-nodes-base.if",

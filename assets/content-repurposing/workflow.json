    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    \"contents\": [\n      {\n        \"role\": \"user\",\n        \"parts\": [\n          {\n            \"text\": \"You are a skilled content writer who turns raw transcripts into engaging blog posts.\\n\\nWrite a blog post of approximately 600 words based on the transcript below. Requirements:\\n- Clear, engaging, conversational tone (not corporate, not academic)\\n- Open with a hook — a question, a surprising claim, or a scene, not \\\"In this post we will discuss...\\\"\\n- Use 3-5 short subheadings to break up the content\\n- Close with a short takeaway or call-to-action, not a generic summary\\n- Do not mention that this was generated from a transcript or podcast\\n- Output ONLY the blog post itself — no preamble like \\\"Here is your blog post\\\", no meta-commentary, no markdown title, just the body content with subheadings\\n\\nTranscript:\\n\" + $('Normalize input').item.json.transcript\n          }\n        ]\n      }\n    ],\n    \"generationConfig\": {\n      \"maxOutputTokens\": 8192,\n      \"temperature\": 0.7\n    }\n  }\n}}",
        "options": {}
      },
      "id": "8ae2afe6-38eb-485d-835d-1d50b0b572ba",
      "name": "Generate Blog Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        880,
        48
      ],
      "retryOnFail": true,
      "credentials": {
        "googlePalmApi": {
          "id": "VRF0WAD1Wc4lfuxr",
          "name": "Google Gemini(PaLM) Api account"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",

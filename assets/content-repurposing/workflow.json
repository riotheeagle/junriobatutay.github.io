    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    \"contents\": [\n      {\n        \"role\": \"user\",\n        \"parts\": [\n          {\n            \"text\": \"You are a social media copywriter who writes tweet threads that people actually stop scrolling for.\\n\\nWrite a 5-tweet thread summarizing the key points of the transcript below. Requirements:\\n- Tweet 1 is a hook — a bold claim, a surprising stat, or a question. It must work as a standalone tweet that makes someone want to read on.\\n- Tweets 2-4 each cover one distinct key point, insight, or takeaway from the content. One idea per tweet.\\n- Tweet 5 closes with a takeaway, a question to the reader, or a light call-to-action (not \\\"link in bio\\\" — just a natural close)\\n- Each tweet must be under 280 characters\\n- No hashtags unless genuinely essential to the point\\n- Do NOT number the tweets with '1/5' style — just write them as clean standalone lines\\n\\nOutput format: Return ONLY valid JSON in this exact structure:\\n{\\\"tweets\\\": [\\\"tweet 1 text\\\", \\\"tweet 2 text\\\", \\\"tweet 3 text\\\", \\\"tweet 4 text\\\", \\\"tweet 5 text\\\"]}\\n\\nTranscript:\\n\" + $('Normalize input').item.json.transcript\n          }\n        ]\n      }\n    ],\n    \"generationConfig\": {\n      \"responseMimeType\": \"application/json\",\n      \"maxOutputTokens\": 8192,\n      \"temperature\": 0.5\n    }\n  }\n}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "4682d574-6a06-45bf-a52f-822668e93921",
      "name": "Generate Tweet Thread",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1504,
        48
      ],
      "retryOnFail": true,
      "credentials": {
        "googlePalmApi": {
          "id": "VRF0WAD1Wc4lfuxr",
          "name": "Google Gemini(PaLM) Api account"
        },
        "httpHeaderAuth": {
          "id": "AjKhF4W18JDHlCgn",
          "name": "Gemini"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const item = $input.all()[0].json;\nconst rawText = item.candidates?.[0]?.content?.parts?.[0]?.text;\n\nif (!rawText) {\n  throw new Error(\"Error: Gemini returned empty content.\");\n}\n\n// 1. Clean the markdown fences\nlet cleanText = rawText.replace(/```json/g, \"\");\ncleanText = cleanText.replace(/```/g, \"\");\ncleanText = cleanText.trim();\n\n// 2. Try to parse\ntry {\n  const parsed = JSON.parse(cleanText);\n  \n  if (!parsed.tweets) {\n     throw new Error(\"JSON parsed, but missing 'tweets' array.\");\n  }\n  \n  return [{ json: { tweets: parsed.tweets } }];\n  \n} catch (error) {\n  // 3. We DO NOT put the cleanText in the Error message. \n  // We log it to the console so you can read it safely, \n  // and throw a completely static string so n8n doesn't crash.\n  \n  console.log(\"=== WHAT GEMINI ACTUALLY WROTE ===\");\n  console.log(rawText);\n  console.log(\"==================================\");\n  \n  throw new Error(\"JSON Parse Failed! The text Gemini returned is not valid JSON. Check the n8n Execution Log for Node 6 output, or check the browser console to see the raw text.\");\n}"
      },
      "id": "78aae2ab-160d-4804-bc61-09f4ad258728",
      "name": "Check Thread succeeded + parse",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        288
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    \"contents\": [\n      {\n        \"role\": \"user\",\n        \"parts\": [\n          {\n            \"text\": \"You are a professional writing a LinkedIn post to share an insight from content you consumed.\\n\\nWrite a single LinkedIn post, 150-200 words, based on the transcript below. Requirements:\\n- Professional tone, but written like a real person shares an opinion, not corporate-speak\\n- Open with a strong first line that stands alone (LinkedIn truncates posts, so the first line must earn the click to 'see more')\\n- Focus on ONE key insight or takeaway rather than trying to summarize everything\\n- Include a short personal-sounding reflection or implication of the insight, not just a restatement of facts\\n- End with a light question or discussion prompt to encourage comments\\n- No hashtags, no emojis, no bullet-point lists\\n- Output ONLY the post text — no preamble, no title, no word count note\\n\\nTranscript:\\n\" + $('Normalize input').item.json.transcript\n          }\n        ]\n      }\n    ],\n    \"generationConfig\": {\n      \"maxOutputTokens\": 8192,\n      \"temperature\": 0.7\n    }\n  }\n}}",
        "options": {}
      },
